# Derived data
# The SQLite database is derived from data/raw/, which IS versioned.
data/*.db
data/*.sqlite
data/*.sqlite3

# SQLite transient state — journal / write-ahead log / shared-memory index.
data/*.db-journal
data/*.db-wal 
# alternative to journal above, where the main .db file isn't touched during a writing of new info at all. New changes are appended to a .db-wal file, then the log's contents are folded back into the main file and truncating it.
data/*.db-shm 
# shm is WAL's index or "Shared memory"

# Secrets - add the super duper secret api key
.env
.env.local
# .env example TFL_APP_ID= /TFL_APP_KEY=

# Collector output, cron stdout/stderr- useful locally, noise in the repo
*.log
logs/

__pycache__/
*.pyc
.venv/
venv/

.DS_Store
